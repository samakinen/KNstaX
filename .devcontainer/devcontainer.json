{
	"name": "ESP-IDF QEMU",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"idf.espIdfPath": "/opt/esp/idf",
				"idf.toolsPath": "/opt/esp",
				"idf.gitPath": "/usr/bin/git"
			},
			"extensions": [
				"espressif.esp-idf-extension",
				"espressif.esp-idf-web",
				"ms-vscode.cpptools",
				"ms-vscode.cpptools-extension-pack",
				"twxs.cmake",
				"ms-vscode.cmake-tools"
			]
		}
	},
	"runArgs": [
		"--privileged",
		"--net=host"
	],
    "mounts": [],
    // "mounts": [
    //     "type=volume,target=/workspaces/KNstaX/build,source=esp-idf-build-volume"
    // ],
    //"postCreateCommand": "mkdir -p /workspaces/KNstaX/build && chmod -R 777 /workspaces/KNstaX/build"
}
