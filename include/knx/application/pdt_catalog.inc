/*
 * PDT catalog - single source of truth for Property Data Types
 * New format: KNX_PDT_CATALOG_ENTRY(EnumName, PDT_TOKEN, Value, ElementSize, "Description")
 *  - `Value` is the numeric PDT token (hex or decimal) used in KNX definitions.
 *  - `ElementSize` is the size in bytes of a single element (0 == variable length).
 */
KNX_PDT_CATALOG_ENTRY(Control, PDT_CONTROL, 0x00, 1, "Control (1 byte)")
KNX_PDT_CATALOG_ENTRY(Char, PDT_CHAR, 0x01, 1, "Char (1 byte)")
KNX_PDT_CATALOG_ENTRY(UnsignedChar, PDT_UNSIGNED_CHAR, 0x02, 1, "Unsigned char (1 byte)")
KNX_PDT_CATALOG_ENTRY(Int, PDT_INT, 0x03, 2, "Signed int (2 bytes)")
KNX_PDT_CATALOG_ENTRY(UnsignedInt, PDT_UNSIGNED_INT, 0x04, 2, "Unsigned int (2 bytes)")
KNX_PDT_CATALOG_ENTRY(KnxFloat, PDT_KNX_FLOAT, 0x05, 2, "KNX 2-byte float")
KNX_PDT_CATALOG_ENTRY(Date, PDT_DATE, 0x06, 3, "Date (3 bytes)")
KNX_PDT_CATALOG_ENTRY(Time, PDT_TIME, 0x07, 3, "Time (3 bytes)")
KNX_PDT_CATALOG_ENTRY(Long, PDT_LONG, 0x08, 4, "Long (4 bytes)")
KNX_PDT_CATALOG_ENTRY(UnsignedLong, PDT_UNSIGNED_LONG, 0x09, 4, "Unsigned long (4 bytes)")
KNX_PDT_CATALOG_ENTRY(Float, PDT_FLOAT, 0x0A, 4, "Float (4 bytes)")
KNX_PDT_CATALOG_ENTRY(Double, PDT_DOUBLE, 0x0B, 8, "Double (8 bytes)")
KNX_PDT_CATALOG_ENTRY(CharBlock, PDT_CHAR_BLOCK, 0x0C, 10, "Char block (10 bytes)")
KNX_PDT_CATALOG_ENTRY(ShortCharBlock, PDT_SHORT_CHAR_BLOCK, 0x0E, 5, "Short char block (5 bytes)")
KNX_PDT_CATALOG_ENTRY(DateTime, PDT_DATE_TIME, 0x0F, 8, "DateTime (8 bytes)")
KNX_PDT_CATALOG_ENTRY(VariableLength, PDT_VARIABLE_LENGTH, 0x10, 0, "Variable length")
KNX_PDT_CATALOG_ENTRY(Utf8, PDT_UTF_8, 0x2F, 0, "UTF-8 variable length")
KNX_PDT_CATALOG_ENTRY(Version, PDT_VERSION, 0x30, 2, "Version (2 bytes)")
KNX_PDT_CATALOG_ENTRY(AlarmInfo, PDT_ALARM_INFO, 0x31, 6, "Alarm info (6 bytes)")
KNX_PDT_CATALOG_ENTRY(BinaryInfo, PDT_BINARY_INFORMATION, 0x32, 1, "Binary information (1 byte)")
KNX_PDT_CATALOG_ENTRY(Bitset8, PDT_BITSET8, 0x33, 1, "8-bit bitset")
KNX_PDT_CATALOG_ENTRY(Bitset16, PDT_BITSET16, 0x34, 2, "16-bit bitset")
KNX_PDT_CATALOG_ENTRY(Enum8, PDT_ENUM8, 0x35, 1, "8-bit enum")
KNX_PDT_CATALOG_ENTRY(Scaling, PDT_SCALING, 0x36, 1, "Scaling (1 byte)")
KNX_PDT_CATALOG_ENTRY(Function, PDT_FUNCTION, 0x3E, 1, "Function (1 byte)")
KNX_PDT_CATALOG_ENTRY(Escape, PDT_ESCAPE, 0x3F, 0, "Escape/unknown")

/* Generic slots and remaining entries */
KNX_PDT_CATALOG_ENTRY(PollGroupSettings, PDT_POLL_GROUP_SETTINGS, 0x0D, 3, "Poll group settings")
/* alias removed to avoid duplicate enum entry */
KNX_PDT_CATALOG_ENTRY(GenericData, PDT_GENERIC_01, 0x11, 1, "Generic 1 byte")
