# ESP-IDF generated per-project artefacts. sdkconfig and dependencies.lock are
# both regenerated per target, so committing them pins one SoC and produces a
# spurious diff for anyone building for another. Commit sdkconfig.defaults —
# the handful of settings that actually matter — instead.
sdkconfig
sdkconfig.old
dependencies.lock
