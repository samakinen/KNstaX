# A TP1 end device on a small Cortex-M part: no log strings, nothing a bus
# device does not need, with the smallest capacities the reference product fits.
CONFIG_KNX_STANDALONE_PLATFORM_BAREMETAL=y
CONFIG_KNX_BUILD_TP1=y
CONFIG_KNX_BUILD_NETIP=n
CONFIG_KNX_ENABLE_TUNNELING=n
CONFIG_KNX_ENABLE_COUPLER=n
CONFIG_KNX_ENABLE_SECURITY=n
CONFIG_KNX_BUILD_VIRTUAL_BUS=n
CONFIG_KNX_BUILD_ETS_TOOLING=n
CONFIG_KNX_BUILD_TEST_HOOKS=n
CONFIG_KNX_BUILD_ZLIB=n
CONFIG_KNX_LOG_LEVEL=0
CONFIG_KNX_MAX_APDU_LENGTH=15
CONFIG_KNX_TP1_RX_QUEUE_FRAMES=4
CONFIG_KNX_TRANSPORT_RX_QUEUE=2
CONFIG_KNX_ADDRESS_TABLE_ENTRIES=128
CONFIG_KNX_ASSOCIATION_TABLE_ENTRIES=160
CONFIG_KNX_ADDITIONAL_INDIVIDUAL_ADDRESSES=0
CONFIG_KNX_MAX_GROUP_OBJECT_PAYLOAD_BYTES=14
CONFIG_KNX_SEND_PIPELINE_DEPTH=2
CONFIG_KNX_PENDING_ACTION_CAPACITY=8
CONFIG_KNX_CALLBACK_CAPTURE_BYTES=8
# Optional features: only the function property services stay on (ETS uses
# them to commission an end device). Everything else is absent from the image.
CONFIG_KNX_ENABLE_FUNCTION_PROPERTIES=y
CONFIG_KNX_ENABLE_PROPERTY_EXT=n
CONFIG_KNX_ENABLE_MEMORY_EXT=n
CONFIG_KNX_ENABLE_NETWORK_PARAMETER=n
CONFIG_KNX_ENABLE_GO_DIAGNOSTICS=n
CONFIG_KNX_DPT_FLOAT=n
CONFIG_KNX_DPT_TIME=n
CONFIG_KNX_DPT_STRING=n
CONFIG_KNX_DPT_COLOUR=n
CONFIG_KNX_DPT_ACCESS=n
CONFIG_KNX_ENABLE_DPT_CATALOGUE=n
CONFIG_KNX_HEAP_POLICY_INIT_ONLY=y
# The receive path stays in flash: the board masks interrupts while a page
# erases and the TP-UART2 answers BUSY meanwhile (FlashEraseGuard).
CONFIG_KNX_ISR_IN_RAM=n
