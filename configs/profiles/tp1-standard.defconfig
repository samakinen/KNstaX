# The same device with errors logged: for bring-up and field diagnosis.
# Capacities arrive with the small-target profile's later work items; this
# fragment only selects what is built.
CONFIG_KNX_STANDALONE_PLATFORM_BAREMETAL=y
CONFIG_KNX_BUILD_TP1=y
CONFIG_KNX_BUILD_NETIP=n
CONFIG_KNX_ENABLE_TUNNELING=n
CONFIG_KNX_ENABLE_COUPLER=n
# Data Secure is meant to be on in this profile. It builds with the software
# AES (the size gate measures it on tp1-small, variant secure), but the
# Security Interface Object still allocates during a secure download, which the
# locked heap of this profile refuses: switch it on with the fixed-capacity
# tables (data-secure-small-target.md D3-D5).
# CONFIG_KNX_ENABLE_SECURITY is not set
CONFIG_KNX_BUILD_VIRTUAL_BUS=n
CONFIG_KNX_BUILD_ETS_TOOLING=n
CONFIG_KNX_BUILD_TEST_HOOKS=n
CONFIG_KNX_BUILD_ZLIB=n
CONFIG_KNX_LOG_LEVEL=1
CONFIG_KNX_MAX_APDU_LENGTH=55
CONFIG_KNX_TP1_RX_QUEUE_FRAMES=8
CONFIG_KNX_TRANSPORT_RX_QUEUE=4
CONFIG_KNX_ADDRESS_TABLE_ENTRIES=255
CONFIG_KNX_ASSOCIATION_TABLE_ENTRIES=400
CONFIG_KNX_ADDITIONAL_INDIVIDUAL_ADDRESSES=4
CONFIG_KNX_MEMORY_REGIONS=4
CONFIG_KNX_AUTHORIZED_PARTNERS=1
CONFIG_KNX_MAX_GROUP_OBJECT_PAYLOAD_BYTES=14
CONFIG_KNX_SEND_PIPELINE_DEPTH=4
CONFIG_KNX_PENDING_ACTION_CAPACITY=16
CONFIG_KNX_CALLBACK_CAPTURE_BYTES=8
# Optional features: the standard end device. No coupler, no run-time DPT
# catalogue; Secure and the management services ETS uses are on.
CONFIG_KNX_ENABLE_FUNCTION_PROPERTIES=y
CONFIG_KNX_ENABLE_PROPERTY_EXT=y
CONFIG_KNX_ENABLE_MEMORY_EXT=y
CONFIG_KNX_ENABLE_NETWORK_PARAMETER=y
CONFIG_KNX_ENABLE_GO_DIAGNOSTICS=y
CONFIG_KNX_DPT_FLOAT=y
CONFIG_KNX_DPT_TIME=y
CONFIG_KNX_DPT_STRING=y
CONFIG_KNX_DPT_COLOUR=y
CONFIG_KNX_DPT_ACCESS=y
CONFIG_KNX_ENABLE_DPT_CATALOGUE=n
CONFIG_KNX_HEAP_POLICY_INIT_ONLY=y
