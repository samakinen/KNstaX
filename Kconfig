menu "KNX Stack Configuration"

    choice KNX_MEDIUM
        prompt "KNX Medium"
        default KNX_MEDIUM_TP1
        help
            Select the KNX communication medium
        
        config KNX_MEDIUM_TP1
            bool "TP1 (Twisted Pair)"
            help
                KNX TP1 (Twisted Pair) medium at 9600 baud
        
        config KNX_MEDIUM_IP
            bool "IP (KNXnet/IP)"
            help
                KNXnet/IP over Ethernet/WiFi
    endchoice

    menu "TP1 Configuration"
        depends on KNX_MEDIUM_TP1
        
        choice KNX_TP1_PHYSICAL
            prompt "TP1 Physical Layer"
            default KNX_TP1_BITBANG
            help
                The software bit-bang backend is the only TP1 backend an
                ESP-IDF build offers. The TP-UART2 backend
                (TpUartMediumBackend) is built for standalone and bare-metal
                builds, where the product passes it to the stack; it becomes
                an entry here once there is an ESP-IDF UART HAL for it.

            config KNX_TP1_BITBANG
                bool "Bit-Bang (Software)"
                help
                    Use software bit-bang implementation. This is the tested
                    backend.
        endchoice
        
        config KNX_TP1_BITBANG_TX_PIN
            int "Bit-Bang TX Pin"
            depends on KNX_TP1_BITBANG
            default 17
            help
                GPIO pin for bit-bang TX
        
        config KNX_TP1_BITBANG_RX_PIN
            int "Bit-Bang RX Pin"
            depends on KNX_TP1_BITBANG
            default 16
            help
                GPIO pin for bit-bang RX

        config KNX_TP1_BITBANG_RX_PULLUP
            bool "Enable RX pull-up"
            depends on KNX_TP1_BITBANG
            default y
            help
                Enable internal pull-up on the bit-bang RX pin.

        config KNX_TP1_BITBANG_TX_DOMINANT_HIGH
            bool "TX dominant level is GPIO high"
            depends on KNX_TP1_BITBANG
            default y
            help
                Set to n if the connected TP1 transceiver expects a GPIO low level for dominant transmit drive.

        config KNX_TP1_BITBANG_RX_DOMINANT_HIGH
            bool "RX dominant level is GPIO high"
            depends on KNX_TP1_BITBANG
            default y
            help
                Set to n if the connected TP1 transceiver reports dominant bus level as GPIO low.

        config KNX_TP1_BITBANG_SERIAL_BIT_TIME_US
            int "Bit-bang serial bit time (µs)"
            depends on KNX_TP1_BITBANG
            default 104
            range 90 130
            help
                UART-style bit time used by the TP1 timer ISR state machine.

        config KNX_TP1_BITBANG_ZERO_ACTIVE_US
            int "Bit-bang dominant pulse width (µs)"
            depends on KNX_TP1_BITBANG
            default 35
            range 1 129
            help
                Dominant pulse width used when transmitting a logical zero.

        config KNX_TP1_BITBANG_ZERO_EQUALIZATION_US
            int "Bit-bang equalization width (µs)"
            depends on KNX_TP1_BITBANG
            default 69
            range 1 129
            help
                Recessive equalization time after the dominant zero pulse.

        config KNX_TP1_BITBANG_SAMPLE_OFFSET_US
            int "Bit-bang RX sample offset (µs)"
            depends on KNX_TP1_BITBANG
            default 52
            range 1 129
            help
                Sampling point after the detected RX edge for the bit-bang receiver.

                A received bit is decoded from a sticky flag set by the RX edge
                interrupt, not from the bus level, so the sample point does NOT
                have to fall inside the 35 µs dominant pulse — it only has to
                fall after this bit cell's edge and before the next one. The
                tolerance for a late sampling alarm is therefore
                (serial bit time − this offset), and the tolerance for an early
                one is this offset. Mid-cell (52 µs of a 104 µs cell) splits
                them evenly; the previous 78 µs default left only 26 µs of late
                margin, which measured interrupt latency on a busy ESP32-C6 can
                exceed, silently shifting bits into the wrong position.

        config KNX_TP1_BITBANG_START_BIT_VALIDATION_US
            int "Start bit validation pulse duration (µs)"
            depends on KNX_TP1_BITBANG
            default 15
            range 5 30
            help
                Minimum time the bus must remain dominant after a falling edge
                before the start bit is confirmed. The validation timer fires at
                this offset from the edge and reads the bus level. If the bus has
                already returned recessive, the edge is treated as a glitch and
                discarded. Values of 15-20 µs are recommended. Must be less than
                the zero-active time and the RX sample offset.

        config KNX_TP1_BITBANG_LINK_PIN
            int "Bit-Bang link-health (KNX_OK) pin"
            depends on KNX_TP1_BITBANG
            default 255
            help
                GPIO connected to the transceiver's bus-health output (STKNX
                KNX_OK, TPUART SAVE and equivalents). 255 disables the feature,
                in which case the driver reports LinkState::Unknown and behaves
                exactly as it did before the signal existed.

                With the signal wired, the stack can tell a dead bus from a
                quiet one: it stops burning retransmission budget into an
                unpowered line and can notify the application about bus power
                loss and return.

        config KNX_TP1_BITBANG_LINK_ACTIVE_HIGH
            bool "Link-health signal is active high"
            depends on KNX_TP1_BITBANG
            default y
            help
                Set to n when the transceiver pulls the pin low to indicate a
                healthy bus, or when the output is open-drain with an inverting
                buffer. Check the transceiver datasheet and the board schematic.

        config KNX_TP1_BITBANG_LINK_PULLUP
            bool "Enable pull-up on the link-health pin"
            depends on KNX_TP1_BITBANG
            default n
            help
                Enable the internal pull-up. Required for open-drain
                transceiver outputs without an external pull-up.

        config KNX_TP1_BITBANG_LINK_DOWN_DEBOUNCE_US
            int "Link-down debounce (µs)"
            depends on KNX_TP1_BITBANG
            default 20000
            range 100 5000000
            help
                How long the signal must stay deasserted before the link is
                reported Down. Bus voltage sags under heavy traffic, so a short
                window causes spurious transitions.

                This bounds how late the stack learns about a real outage, so it
                must stay comfortably inside the board's hold-up time — the time
                the local 3V3 rail survives on bulk capacitance after the bus
                dies. Boards whose hold-up is shorter than this window should
                additionally enable the pre-debounce power-fail notification
                below rather than shortening the debounce.

        config KNX_TP1_BITBANG_LINK_UP_DEBOUNCE_US
            int "Link-up debounce (µs)"
            depends on KNX_TP1_BITBANG
            default 200000
            range 100 10000000
            help
                How long the signal must stay asserted before the link is
                reported Up. Longer than the down window on purpose: bus power
                return is bouncy, and declaring Up too early resumes
                transmission into a supply that is still settling.

        config KNX_TP1_BITBANG_LINK_POWERFAIL_ISR
            bool "Notify power-fail from the signal's edge ISR"
            depends on KNX_TP1_BITBANG
            default n
            help
                Deliver a LinkEventKind::PowerFailImminent notification directly
                from the edge interrupt, ahead of the debounce, to whichever
                handler the application registered with
                setPowerFailIsrHandler().

                Only useful on boards whose hold-up time is too short to wait
                out the debounce window — it trades false positives (the signal
                also dips on a marginal bus) for the earliest possible warning.
                The handler runs in interrupt context.

        config KNX_TP1_BITBANG_ISR_SERVICE_FLAGS
            int "Extra GPIO ISR service flags"
            depends on KNX_TP1_BITBANG
            default 8
            help
                Extra flags ORed into the gpio_install_isr_service() call that attaches
                the TP1 RX edge interrupt. The default is 8 (ESP_INTR_FLAG_LEVEL3), which
                matches the gptimer interrupt priority so the two driver ISRs cannot
                preempt each other.

                ESP_INTR_FLAG_IRAM (1024) is always added by the driver and does not need
                to be set here — it is mandatory, because without it the GPIO interrupt is
                disabled for the entire time the flash cache is off (NVS commits during
                ETS commissioning, OTA writes) and TP1 bit timing is lost.

                KNstaX always calls gpio_install_isr_service() and tolerates the service
                already existing, so no separate "install" switch is needed. Note that the
                service is global: the IRAM requirement applies to every GPIO ISR handler
                the application attaches, not just KNstaX's.

        config KNX_TP1_BITBANG_TIMING_STATS
            bool "Enable ISR timing statistics (development only)"
            depends on KNX_TP1_BITBANG
            default n
            help
                Collect rolling min/max/average statistics inside the bitbang ISR driver:
                  - Timer alarm jitter: how many µs late each timer ISR fires vs the
                    scheduled alarm time. Large values (> ~20 µs) correlate with framing
                    errors and are the primary diagnostic for tuning timing parameters.
                  - onTimerAlarm() total execution time in CPU cycles.
                  - onRxEdge() total execution time in CPU cycles.
                  - processStartBit() execution time in CPU cycles.
                  - processReceiveBit() execution time in CPU cycles.

                When disabled (the default) every instrumentation macro expands to nothing
                — the compiler emits zero extra code and there is no runtime overhead.

                When enabled, each timer ISR adds two esp_cpu_get_cycle_count() reads
                (single-cycle CSR reads on RISC-V) plus one knx_timer_gpio_hal_timer_now_us()
                call. Each GPIO edge ISR adds two cycle reads. These costs are measurable
                in the statistics themselves.

                Do NOT leave this enabled in production builds.

        config KNX_ENABLE_COUPLER
            bool "Coupler (line / backbone router role)"
            depends on KNX_ENABLE_FUNCTION_PROPERTIES
            default n
            help
                Build the router role of a TP1 line or backbone coupler
                (03/05/01): the Filter Table and its load control, the Router
                Object with its PID_*_LCCONFIG properties, load state and the
                route table control function property, the two-port coupler and
                its routing policy (CouplerOptions, createTp1CouplerStackPort,
                configureRouterRole), and the layer-2 group acknowledge a
                coupler gives from the receive interrupt (GROUP_IACK_ROUT,
                03/05/01 4.5.5).

                An end device is not a router and does not need any of it. With
                this off the sources are not compiled and the API does not
                exist, so ETS sees no Router Object and the device cannot be
                given a router role. Needs the function property services.
    endmenu

    menu "IP Configuration"
        depends on KNX_MEDIUM_IP
        
        config KNX_ENABLE_TUNNELING
            bool "Enable Tunneling"
            depends on !(KNX_ENABLE_SECURITY && MBEDTLS_VER_4_X_SUPPORT)
            default y
            help
                Enable KNXnet/IP Tunneling (unicast): the client role, this
                device opening a connection to a KNXnet/IP gateway. A KNX IP
                device (03/02/06) is not a tunnelling client, so an image that
                only has to be commissioned by ETS does not need this, and
                with it off the client sources (gateway discovery, the
                device-management connection, the TCP channel and the secure
                session) are not built.

                Not available when KNX Secure is enabled against mbedTLS 4
                (ESP-IDF 6.x): IP Secure session establishment needs X25519 and
                PBKDF2 from the legacy mbedTLS API, which mbedTLS 4 no longer
                exposes. Data Secure and Secure Routing are unaffected.

        comment "Tunnelling withdrawn: IP Secure sessions need X25519/PBKDF2 from the legacy mbedTLS API, gone in mbedTLS 4"
            depends on KNX_ENABLE_SECURITY && MBEDTLS_VER_4_X_SUPPORT
        
        config KNX_IP_PORT
            int "KNXnet/IP Port"
            default 3671
            help
                UDP port for KNXnet/IP communication

        config KNX_NETIP_UDP_BUFFER_SIZE
            int "KNXnet/IP UDP scratch buffer size"
            default 1500
            range 512 4096
            help
                Fixed-capacity UDP scratch buffer for KNXnet/IP datagrams.
                Keep this near the expected MTU for embedded builds.

        config KNX_NETIP_DEVICE_MANAGEMENT_BUFFER_SIZE
            int "KNXnet/IP device-management buffer size"
            default 2048
            range 512 4096
            help
                Fixed-capacity request/response buffer for device-management payload exchanges.

        config KNX_NETIP_TCP_BUFFER_SIZE
            int "KNXnet/IP TCP frame buffer size"
            default 4096
            range 512 8192
            help
                Fixed-capacity framed TCP scratch buffer for secure tunneling and session bootstrap.

        config KNX_NETIP_TUNNELING_KEEPALIVE_INTERVAL_MS
            int "KNXnet/IP tunneling keepalive interval (ms)"
            default 60000
            range 1000 120000
            help
                Default tunneling connection-state request interval.
    endmenu

    menu "Security Configuration"
        
        config KNX_ENABLE_SECURITY
            bool "Enable KNX Secure"
            default n
            select KNX_ENABLE_PROPERTY_EXT
            select KNX_ENABLE_FUNCTION_PROPERTIES
            help
                Enable KNX Data Security and/or System-B Secure: the Security
                Interface Object (object type 17), the secure application layer
                and the crypto they use. Data Secure is configured with the
                extended property services and function properties (ETS sets the
                Security Mode with them), so this selects KNX_ENABLE_PROPERTY_EXT
                and KNX_ENABLE_FUNCTION_PROPERTIES.

                With it off the Security Interface Object is not compiled, not
                registered and not exposed: ETS finds no object 17.
    endmenu

    menu "Optional Features"

        # Every symbol here defaults to y, the behaviour before they were
        # switches. A feature that is off is absent: its sources are not
        # compiled and the API that needs it does not exist.

        config KNX_ENABLE_FUNCTION_PROPERTIES
            bool "Function property services"
            default y
            help
                A_FunctionPropertyCommand, A_FunctionPropertyStateRead and the
                A_FunctionPropertyStateResponse they answer with
                (03/03/07 3.5). The router role (route table control), the group
                object diagnostics and the KNXnet/IP Parameter Object commands
                use them, so those features depend on this one. A request for
                the service when it is off is ignored, as an unknown APCI is.

        config KNX_ENABLE_PROPERTY_EXT
            bool "Extended property services"
            default y
            help
                The A_PropertyExt* services (03/03/07 3.5), which address
                objects by an extended object index and properties above 255.
                KNX Secure needs them, so enabling that selects this. A request
                for the service when it is off is ignored, as an unknown APCI is.

        config KNX_ENABLE_MEMORY_EXT
            bool "Extended memory services"
            default y
            help
                A_MemoryExtendedRead and A_MemoryExtendedWrite (03/03/07 3.5):
                24-bit addressing for memory above 64 KiB. A request when off is
                ignored, as an unknown APCI is.

        config KNX_ENABLE_NETWORK_PARAMETER
            bool "Network parameter services"
            default y
            help
                A_NetworkParameterRead, A_NetworkParameterResponse and
                A_NetworkParameterWrite (03/03/07 3.5). A request when off is
                ignored, as an unknown APCI is.

        config KNX_ENABLE_GO_DIAGNOSTICS
            bool "Group object diagnostics"
            depends on KNX_ENABLE_FUNCTION_PROPERTIES
            default y
            help
                The group object diagnostic commands ETS sends to the group
                object table (property 66, as function properties). When off the
                property is not advertised. Needs the function property services.

        config KNX_DPT_FLOAT
            bool "Floating point datapoint types (DPT 9, 14)"
            default y
            help
                DPT 9 (2-octet float) and DPT 14 (4-octet float), their codecs
                and the semantic types built on them (temperature, illuminance,
                power and so on). A product port that uses one does not compile
                when this is off. Off also keeps floating point arithmetic out
                of the image where the group object code allows it.

        config KNX_DPT_TIME
            bool "Time and date datapoint types (DPT 10, 11, 19)"
            default y
            help
                DPT 10 (time of day), DPT 11 (date) and DPT 19 (date and time).

        config KNX_DPT_STRING
            bool "String datapoint types (DPT 4, 16)"
            default y
            help
                DPT 4 (character) and DPT 16 (14-octet string).

        config KNX_DPT_COLOUR
            bool "Colour datapoint types (DPT 232, 242, 249, 251)"
            default y
            help
                RGB, xyY, tunable white and RGBW colour datapoint types.

        config KNX_DPT_ACCESS
            bool "Access identification datapoint type (DPT 15)"
            default y
            help
                DPT 15, the access identification code.

        config KNX_ENABLE_DPT_CATALOGUE
            bool "Datapoint type catalogue (names and lookup table)"
            default y
            help
                The run-time table of known datapoint types with their names
                and descriptions (lookupDptInfo and the name lookups). A device
                does not need it to run: its group objects use the codecs
                directly. Off saves the table and the strings.
    endmenu

    menu "Object Limits"

        config KNX_MAX_GROUP_OBJECT_PAYLOAD_BYTES
            int "Group object payload capacity (octets)"
            default 16
            range 14 254
            help
                Payload octets reserved per group object.  Each object holds two
                buffers of this size (current value plus last-transmitted value
                for send-on-change), so the cost is paid twice per object.

                The default of 16 covers every datapoint type in the catalog
                (the widest is DPT 16 at 14 octets) and keeps a group object at
                ~288 bytes instead of ~768.  Raise it only for a product that
                uses group objects as opaque transport for larger blobs.
                Oversized payloads are rejected, never truncated.
    endmenu

    menu "Capacities"

        # Not conditional on a medium: every build defines these, so config.hpp
        # has no fallback for any of them. The defaults are the values the stack
        # had before they were configurable. A capacity is a promise: when the
        # table or queue is full the stack answers with an error (and the KNX
        # negative response where one exists), never an overwrite.

        config KNX_MAX_APDU_LENGTH
            int "Maximum APDU length (octets)"
            default 254
            range 15 254
            help
                The largest APDU the device accepts and sends, which is also the
                value it reports in PID_MAX_APDU_LENGTH. Every frame buffer, the
                receive queues and the transport buffers are sized from it.

                15 or less means standard frames only: a TP1 frame is then at
                most 23 octets (03/02/02), and an extended frame addressed to the
                device is dropped at the data link layer. Above 15 the buffers
                are sized for an extended frame (APDU + 9 octets, 263 for 254).
                A product's ProductIdentity::maxApduLength must not exceed it.

        config KNX_TP1_RX_QUEUE_FRAMES
            int "TP1 receive queue (frames)"
            default 32
            range 2 32
            help
                Frames the TP1 MAC layer buffers between the medium and the data
                link layer, each sized for the longest frame. When it is nearly
                full the device answers new frames with BUSY; if it is full a
                frame already acknowledged is dropped and counted.

        config KNX_TRANSPORT_RX_QUEUE
            int "Transport layer receive queue (frames)"
            default 8
            range 1 8
            help
                Frames the transport layer queues for processing. A frame that
                arrives while it is full is dropped and counted.

        config KNX_ADDRESS_TABLE_ENTRIES
            int "Group address table entries"
            default 256
            range 1 256
            help
                Capacity of the address table, and of the group address list the
                data link layer filters on. ETS is told this size in the .knxprod;
                a table that does not fit is refused with a negative response.

        config KNX_ASSOCIATION_TABLE_ENTRIES
            int "Association table entries"
            default 512
            range 1 512
            help
                Capacity of the association table. ETS is told this size in the
                .knxprod; a table that does not fit is refused with a negative
                response.

        config KNX_ADDITIONAL_INDIVIDUAL_ADDRESSES
            int "Additional individual addresses"
            default 16
            range 0 16
            help
                Individual addresses the data link layer answers to besides its
                own (the tunnel addresses of a KNXnet/IP interface). 0 for an end
                device. Setting more is refused with an error.

        config KNX_SEND_PIPELINE_DEPTH
            int "Send outcome queue depth"
            default 8
            range 1 8
            help
                Send outcomes the application layer holds for the application to
                collect. When it is full the oldest outcome is dropped and
                counted.

        config KNX_PENDING_ACTION_CAPACITY
            int "Pending product actions"
            default 0
            range 0 256
            help
                Publishes and read responses a commissioned product can have
                queued before the stack has started. 0 means twice the
                product's port count (one publish and one read response per
                port), which cannot overflow. A smaller number saves 40 bytes
                of RAM per entry on a 32-bit target. When the queue is full the
                request fails with QueueFull; nothing already queued is
                dropped.

        config KNX_CALLBACK_CAPTURE_BYTES
            int "Callback capture bytes"
            default 0
            range 0 64
            help
                Inline capture bytes of the callbacks the stack keeps (the
                util::InplaceFunction aliases that default to 32 or 64). 0 keeps
                those defaults. A smaller value saves RAM in every callback the
                stack holds, and makes a callback whose capture does not fit a
                compile error: stack-internal callbacks capture only a pointer,
                so 8 is enough on a 32-bit target, but a lambda you pass in must
                fit as well. It never raises a default.
    endmenu

    menu "Task Configuration"
        
        config KNX_RX_TASK_STACK_SIZE
            int "RX Task Stack Size (bytes)"
            default 3072
            range 2048 8192
            help
                Stack size for frame reception task
    endmenu

    menu "Management"

        config KNX_RESTART_PROCESS_TIME_S
            int "Restart process time reported to ETS (seconds)"
            default 0
            range 0 65535
            help
                Process_Time reported in A_Restart_Response after a master
                reset. A management client waits this long before it touches
                the device again.

                0 declares "back in under 5 s", which is right for a device
                that only restarts its own firmware. A device that has to
                bring a network link back up first — a KNXnet/IP device on
                Wi-Fi needs seconds to associate and get an address — must
                report the real figure: understating it makes ETS exhaust its
                retries while the device is still booting and report the
                download as failed. Overstating it only costs some patience,
                once per download.

    endmenu

    menu "Memory"

        choice KNX_HEAP_POLICY
            prompt "Heap policy"
            default KNX_HEAP_POLICY_FREE
            help
                What the stack may do with the heap once it has started.

            config KNX_HEAP_POLICY_FREE
                bool "free"
                help
                    Allocate and free through the toolchain's operator new as
                    needed (the default).

            config KNX_HEAP_POLICY_INIT_ONLY
                bool "init_only"
                help
                    The stack allocates while it starts and the product calls
                    knx::heap::lock() when start-up is over (see
                    knx/util/heap.hpp). An allocation after that traps in a
                    debug build and fails as an exhausted heap does in a
                    release build. Replaces operator new with one that asks
                    the policy first.
        endchoice

    endmenu

    menu "Logging"
        
        config KNX_LOG_LEVEL
            int "Log Level (compile-time ceiling)"
            default 3
            range 0 5
            help
                0=None, 1=Error, 2=Warning, 3=Info, 4=Debug, 5=Verbose

                The most verbose KNstaX log level compiled into the image.
                Calls above it are compiled out, so their format strings cost
                no flash.
    endmenu

endmenu
